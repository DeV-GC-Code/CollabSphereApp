# ================================================================
# CollabSphere — credentials template
#
# Copy to .env.local and fill in your values.
# Source before running any service:
#   set -a && source .env.local && set +a
#
# .env.local is gitignored — never commit real credentials.
# ================================================================

# JWT signing key — shared across every service, must be identical
# Generate one: openssl rand -hex 32
secret=

# PostgreSQL
dbuserId=
dbuserpwd=

# Neo4j (connections-service)
neoUserId=neo4j
neoPwd=

# MongoDB (messages-service)
mongoUserId=
mongoUserPwd=

# Admin account auto-created on first boot by user-service
ADMIN_EMAIL=admin@example.com

# Demo accounts seeded on first boot
# Must satisfy: 8+ chars, no spaces, 1 uppercase, 1 number
# Leave blank to skip seeding
SEED_DEFAULT_PASSWORD=
