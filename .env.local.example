# ================================================================
# CollabSphere — local environment template
# Copy to .env.local and fill in your values.
# .env.local is gitignored — NEVER commit real credentials.
# ================================================================

# ── JWT (shared across all services) ────────────────────────────
# Must be at least 32 characters.
secret=collabsphere-local-secret-key-32chars-minimum

# ── PostgreSQL ───────────────────────────────────────────────────
dbuserId=postgres
dbuserpwd=postgres

# ── Neo4j (connections-service) ─────────────────────────────────
neoUserId=neo4j
neoPwd=yourpassword

# ── MongoDB (messages-service) ──────────────────────────────────
mongoUserId=mongouser
mongoUserPwd=mongopass
MONGODB_URI=mongodb://mongouser:mongopass@localhost:27017/collabsphere_messages?authSource=admin

# ── Admin user (auto-created on first boot) ──────────────────────
ADMIN_EMAIL=admin@example.com

# ── Seed password ────────────────────────────────────────────────
# Used by user-service DataInitializer to create demo accounts on first boot.
# Must satisfy password policy: ≥8 chars, no spaces, ≥1 uppercase, ≥1 number.
# Leave blank (or omit) to disable automatic user seeding entirely.
SEED_DEFAULT_PASSWORD=

# ── Optional overrides ───────────────────────────────────────────
# UI_PORT=3000
