{
  "name": "PostLikedEvent",
  "namespace": "com.gc.CollabSphereApp.event",
  "type": "record",
  "fields": [
    {
      "name": "id",
      "type": "long",
      "default": 0
    },
    {
      "name": "postid",
      "type": "long",
      "default": 0
    },
    {
      "name": "userid",
      "type": "long",
      "default": 0,
      "doc": "Post OWNER's user id — the notification recipient."
    },
    {
      "name": "likedbyuserid",
      "type": "long",
      "default": 0,
      "doc": "The user who performed the like (the actor)."
    }
  ]
}